{
  "name": "hyperfocus",
  "displayName": "hyperfocus \u2014 learn while your AI codes",
  "description": "See your hyperfocus quiz stats, weak spots and saved questions next to your code. For Claude Code, Codex and Gemini CLI.",
  "version": "0.1.0",
  "publisher": "ddalus",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hyperfocus",
          "title": "hyperfocus",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hyperfocus": [
        {
          "type": "webview",
          "id": "hyperfocus.panel",
          "name": "Learning"
        }
      ]
    },
    "commands": [
      {
        "command": "hyperfocus.start",
        "title": "hyperfocus: Start in a terminal"
      },
      {
        "command": "hyperfocus.openNotebook",
        "title": "hyperfocus: Open saved questions"
      },
      {
        "command": "hyperfocus.refresh",
        "title": "hyperfocus: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hyperfocus.refresh",
          "when": "view == hyperfocus.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "hyperfocus",
      "properties": {
        "hyperfocus.command": {
          "type": "string",
          "default": "npx @ddalus/hyperfocus",
          "description": "How to start hyperfocus in the terminal, for example `hyperfocus` or `hyperfocus codex`."
        },
        "hyperfocus.home": {
          "type": "string",
          "default": "",
          "description": "Where hyperfocus keeps its data. Empty means ~/.hyperfocus (or HYPERFOCUS_HOME)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TEJASVISJAIN/hyperfocus-web"
  },
  "homepage": "https://tejasvisjain.github.io/hyperfocus-web/",
  "icon": "media/icon.png",
  "keywords": [
    "ai",
    "claude",
    "claude code",
    "codex",
    "gemini",
    "quiz",
    "learning",
    "code review",
    "copilot",
    "agent"
  ],
  "galleryBanner": {
    "color": "#0A7C8C",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/TEJASVISJAIN/hyperfocus-web/issues"
  }
}
